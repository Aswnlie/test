{{#if notFound}}
<section class="movie-not-found">
  <h1>Movie not found</h1>
  <p>This movie does not exist or was removed.</p>
  <a href="/">Back to the home page</a>
</section>
{{else}}
<article class="movie-details">
  <header class="movie-details__header">
    <h1>{{title}}</h1>
  </header>

  <img class="movie-details__poster" src="{{posterPath}}" alt="Poster of {{title}}">

  <dl class="movie-details__info">
    <dt>Director</dt>
    <dd>{{director}}</dd>
    <dt>Year of release</dt>
    <dd>{{releaseYear}}</dd>
    <dt>Added by</dt>
    <dd>{{author}}</dd>
    <dt>Date added</dt>
    <dd><time datetime="{{addedOn}}">{{addedOn}}</time></dd>
  </dl>

  <section class="movie-details__description">
    <h2>Description</h2>
    <div class="markdown">{{{descriptionHtml}}}</div>
  </section>

{{#if reviews.length}}
  <div class="movie-details__reviews-list">
    {{#each reviews}}
      <article class="movie-details__review">
        <div class="movie-details__review-header">
          <span class="movie-details__review-rating">★ {{this.rating}}/5</span>
          <span class="movie-details__review-author">{{this.username}}</span>
          <time class="movie-details__review-date" datetime="{{this.createdAt}}">{{this.createdAt}}</time>
        </div>
        <div class="movie-details__review-body markdown">
          {{{this.contentHtml}}}
        </div>
      </article>
    {{/each}}
  </div>
{{else}}
  <p class="movie-details__no-reviews">No reviews yet. Be the first to review this movie!</p>
{{/if}}
{{#if user}}
  {{#if reviewError}}
    <p class="alert alert--error" role="alert">{{reviewError}}</p>
  {{/if}}

  <form action="/movies/{{#if movie.id}}{{movie.id}}{{else}}{{id}}{{/if}}/reviews" method="post">
    <input type="hidden" name="csrf" value="{{#if csrfToken}}{{csrfToken}}{{else}}{{csrf}}{{/if}}">

    <div class="form-group">
      <label for="rating">Rating (1 to 5 stars):</label>
      <select id="rating" name="rating" required>
        <option value="5" selected>★ ★ ★ ★ ★ (5 - Excellent)</option>
        <option value="4">★ ★ ★ ★ ☆ (4 - Good)</option>
        <option value="3">★ ★ ★ ☆ ☆ (3 - Average)</option>
        <option value="2">★ ★ ☆ ☆ ☆ (2 - Poor)</option>
        <option value="1">★ ☆ ☆ ☆ ☆ (1 - Terrible)</option>
      </select>
    </div>

    <div class="form-group">
      <label for="content">Your review</label>
      <textarea id="content" name="content" required maxlength="2000" placeholder="Write your review here...">{{reviewContent}}</textarea>
      <small class="form-help">Markdown is supported: **bold**, *italic*, - list items.</small>
    </div>

    <button class="btn-primary" type="submit">Submit review</button>
  </form>
{{else}}
  <p class="movie-details__login-prompt">Please <a href="/login">log in</a> to submit a review.</p>
{{/if}}