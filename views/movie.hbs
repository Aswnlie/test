{{#if notFound}}
<section class="movie-not-found">
  <h1>Movie not found</h1>
  <p>This movie does not exist or was removed.</p>
  <a href="/">Back to the home page</a>
</section>
{{else}}
<article class="movie-details">
  <header class="movie-details__header">
    <h1>{{title}}</h1>
  </header>

  <img class="movie-details__poster" src="{{posterPath}}" alt="Poster of {{title}}">

  <dl class="movie-details__info">
    <dt>Director</dt>
    <dd>{{director}}</dd>
    <dt>Year of release</dt>
    <dd>{{releaseYear}}</dd>
    <dt>Added by</dt>
    <dd>{{author}}</dd>
    <dt>Date added</dt>
    <dd><time datetime="{{addedOn}}">{{addedOn}}</time></dd>
  </dl>

  <section class="movie-details__description">
    <h2>Description</h2>
    <div class="markdown">{{{descriptionHtml}}}</div>
  </section>
  <section aria-label="Reviews">
    <h2>User reviews</h2>
    {{#if reviews.length}}
      {{#each reviews}}
        <article>
          <h3>★ {{this.rating}}/5 · {{this.username}}</h3>
          <p><time datetime="{{this.createdAt}}">{{this.createdAt}}</time></p>
          <div class="markdown">{{{this.contentHtml}}}</div>
        </article>
      {{/each}}
    {{else}}
      <p>No reviews yet. Be the first to review this movie!</p>
    {{/if}}
  </section>

  <section aria-label="Add review">
    <h2>Write a review</h2>
    {{#if user}}
      {{#if reviewError}}<p role="alert">{{reviewError}}</p>{{/if}}
      <form action="/movie/{{id}}/review" method="post">
        <input type="hidden" name="csrf" value="{{csrf}}">
        <p>
          <label for="rating">Rating: <output for="rating">3</output> / 5</label>
          <input id="rating" name="rating" type="range" min="1" max="5" step="1" value="3" required>
        </p>
        <p>
          <label for="content">Your review</label>
          <textarea id="content" name="content" required maxlength="2000">{{reviewContent}}</textarea>
          <small>Markdown is supported: **bold**, *italic*, - list items.</small>
        </p>
        <button type="submit">Submit review</button>
      </form>
    {{else}}
      <p>Please <a href="/login">log in</a> to submit a review.</p>
    {{/if}}
  </section>

  <a class="movie-details__back" href="/">Back to all movies</a>
</article>
{{/if}}