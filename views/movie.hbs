{{#if notFound}}
<section class="movie-not-found">
  <h1>Movie not found</h1>
  <p>This movie does not exist or was removed.</p>
  <a href="/">Back to the home page</a>
</section>
{{else}}
<article class="movie-details">
  <header class="movie-details__header">
    <h1>{{title}}</h1>
  </header>

  <img class="movie-details__poster" src="{{posterPath}}" alt="Poster of {{title}}">

  <dl class="movie-details__info">
    <dt>Director</dt>
    <dd>{{director}}</dd>
    <dt>Year of release</dt>
    <dd>{{releaseYear}}</dd>
    <dt>Added by</dt>
    <dd>{{author}}</dd>
    <dt>Date added</dt>
    <dd><time datetime="{{addedOn}}">{{addedOn}}</time></dd>
  </dl>

  <section class="movie-details__description">
    <h2>Description</h2>
    <div class="markdown">{{{descriptionHtml}}}</div>
  </section>
  <section class="movie-details__reviews">
    <h2>User Reviews</h2>
    {{#if reviews.length}}
      <div class="movie-details__reviews-list">
        {{#each reviews}}
          <div class="movie-details__review">
            <span class="movie-details__review-rating">★ {{this.rating}}/5</span>
            <span class="movie-details__review-author"><strong>{{this.username}}</strong></span>
            <span class="movie-details__review-date"><time datetime="{{this.createdAt}}">{{this.createdAt}}</time></span>
          
          <div class="movie-details__review-body markdown">
            {{{this.contentHtml}}}
          </div>
        </div>
        {{/each}}
      </div>
    {{else}}
      <p class="movie-details__no-reviews">No reviews yet. Be the first to review this movie!</p>
    {{/if}}
    {{#if user}}
    <form action="/movies/{{id}}/reviews" method="POST">
      <textarea name="content" placeholder="Write your review here..."></textarea>
      
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <input type="radio" name="rating" value="5" id="rating-5">
    <label for="rating-5">5★ stars</label>
    <input type="radio" name="rating" value="4" id="rating-4">
    <label for="rating-4">4★ stars</label>
    <input type="radio" name="rating" value="3" id="rating-3">
    <label for="rating-3">3★ stars</label>
    <input type="radio" name="rating" value="2" id="rating-2">
    <label for="rating-2">2★ stars</label>
    <input type="radio" name="rating" value="1" id="rating-1">
    <label for="rating-1">1★ star</label>
    <button type="submit" class="btn-primary">Submit Review</button>
    </form>
    {{else}}
      <p class="movie-details__login-prompt">Please <a href="/login">log in</a> to submit a review.</p>
    {{/if}}
    
    
  </section>

  <a class="movie-details__back" href="/">Back to all movies</a>
</article>
{{/if}}